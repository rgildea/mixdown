{
  "rules": [
    {
      "allowed": {
        "origins": ["http://localhost:3000", "https://*.vercel.app"],
        "methods": ["GET", "PUT", "HEAD"],
        "headers": ["content-type", "range"]
      },
      "exposeHeaders": ["ETag", "Content-Length", "Content-Range", "Accept-Ranges"],
      "maxAgeSeconds": 3600
    }
  ]
}
