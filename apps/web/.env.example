# Copy to apps/web/.env.local. Vercel: set the same names per environment.

# --- Supabase. Safe in the browser; RLS protects the data. ---
# Local stack (`npm run db:start`): these are the Supabase CLI's fixed demo values, not secrets.
# Hosted (Vercel): Project Settings → API → Project URL + anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Public base URL for links we hand out (share links). On Vercel set it to the PRODUCTION URL for both
# Production and Preview, then redeploy (NEXT_PUBLIC_* is baked in at build time). If it's missing or a
# localhost value on Vercel, the app falls back to Vercel's own production domain.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Audio storage. SERVER-ONLY: never prefix with NEXT_PUBLIC_. Read only in src/lib/r2.ts. ---
# Local (`npm run db:start` runs RustFS, an S3-compatible stand-in for R2). Fixed dev values:
R2_ENDPOINT=http://127.0.0.1:55340
R2_ACCESS_KEY_ID=mixdown-dev
R2_SECRET_ACCESS_KEY=mixdown-dev-secret
R2_BUCKET=mixdown-local
# Hosted (Vercel): leave R2_ENDPOINT unset and set R2_ACCOUNT_ID plus the bucket-scoped token
# (R2 → Manage API tokens; Object Read & Write on that bucket only):
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET=mixdown-dev

# No SUPABASE_SERVICE_ROLE_KEY: the app never uses it (ADR 0004/0005).
