# Copy to apps/web/.env.local. Vercel: set the same names per environment.

# --- Supabase (Project Settings → API). Safe in the browser; RLS protects the data. ---
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Absolute site URL, used for magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare R2 (R2 → Manage API tokens; scope: this bucket, Object Read & Write). ---
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Read only in src/lib/r2.ts.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mixdown-dev

# No SUPABASE_SERVICE_ROLE_KEY: the app never uses it (ADR 0004/0005).
