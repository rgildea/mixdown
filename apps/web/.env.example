# Copy to apps/web/.env.local. Vercel: set the same names per environment.

# --- Supabase. Safe in the browser; RLS protects the data. ---
# Local stack (`npm run db:start`): these are the Supabase CLI's fixed demo values, not secrets.
# Hosted (Vercel): Project Settings → API → Project URL + anon/publishable key.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:55321
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0

# Absolute site URL, used for magic-link redirects.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Cloudflare R2 (R2 → Manage API tokens; scope: this bucket, Object Read & Write). ---
# SERVER-ONLY. Never prefix with NEXT_PUBLIC_. Read only in src/lib/r2.ts.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=mixdown-dev

# No SUPABASE_SERVICE_ROLE_KEY: the app never uses it (ADR 0004/0005).
